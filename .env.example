# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Reactive Resume API key: rxresu.me → Settings → API Keys → Create a new API key
RXRESUME_API_KEY=your-rxresume-api-key

# API base URL. Cloud default below; for self-hosted use https://<host>/api/openapi
RXRESUME_BASE_URL=https://rxresu.me/api/openapi

# Optional: saved AI provider id (rxresu.me → Settings → AI) used to parse the PDF.
# Leave empty to use the account default.
RXRESUME_AI_PROVIDER_ID=

# Max accepted PDF size in MB (Telegram bot download limit is ~20 MB)
MAX_PDF_SIZE_MB=15
